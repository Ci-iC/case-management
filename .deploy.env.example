# 部署目标服务器配置 —— 复制此文件为 .deploy.env 后填入实际值
#
#   cp .deploy.env.example .deploy.env
#
# .deploy.env 会被 deploy.sh 读取，请勿提交到 git（本文件已在 .gitignore 中排除）。

# 服务器公网 IP 或域名（必填）
DEPLOY_HOST=<<请填写：服务器公网 IP 或域名>>

# SSH 登录用户（多数云厂商默认是 root）
DEPLOY_USER=<<请填写：SSH 登录用户>>

# SSH 端口（通常 22）
DEPLOY_PORT=22

# 程序在服务器上的部署目录
DEPLOY_DIR=/opt/case-management

# pm2 进程名（多实例部署时要互不相同，比如 case-mgmt-a / case-mgmt-b）
PM2_NAME=case-mgmt
