{
  "name": "case-management-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm:server:dev\" \"vite\"",
    "web": "vite",
    "server:dev": "nodemon --watch server --ext js --ignore server/data server/index.js",
    "server:start": "node server/index.js",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "deploy": "bash deploy.sh",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "knex migrate:latest",
    "db:rollback": "knex migrate:rollback",
    "db:seed": "node server/seed.js",
    "db:reset": "docker compose down -v && docker compose up -d postgres && node scripts/wait-pg.js && knex migrate:latest && node server/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "cors": "^2.8.6",
    "date-fns": "^3.3.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.9",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.0",
    "tailwind-merge": "^2.2.1",
    "word-extractor": "^1.0.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^9.2.1",
    "electron": "^29.4.6",
    "nodemon": "^3.1.14",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  }
}
