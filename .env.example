PORT=4000

# ─── v1.3.2 安全加固：以下两项必须正确配置 ────────────────────────────────────
#
# 【必填】JWT 签名密钥。必须设置且不能保留为占位字符串，否则启动直接报错。
# 生成方式（在能跑 node 的机器上跑一遍，把输出粘到下面）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<<请填写：64位随机十六进制字符串>>

# 【选填】CORS 允许的来源。
#   - 留空 = 同源部署（前后端一起部署，浏览器只能从同一域名访问），最安全的默认。
#   - 多个域名用英文逗号分隔，如：CORS_ORIGIN=https://a.example.com,https://b.example.com
#   - 千万不要写 * （等于全开放，谁都能调你的 API）
CORS_ORIGIN=

# First-run admin seed (only used if no admin exists yet)
ADMIN_USERNAME=<<请填写：初始管理员账号>>
ADMIN_PASSWORD=<<请填写：初始管理员强密码，首次登录后立刻改>>
ADMIN_DISPLAY_NAME=系统管理员

# PostgreSQL — used by both docker-compose and the app
PG_DB=case_mgmt
PG_USER=case_mgmt
PG_PASSWORD=<<请填写：PostgreSQL 数据库密码>>
DATABASE_URL=postgres://case_mgmt:<<请填写：与上方 PG_PASSWORD 一致>>@127.0.0.1:5432/case_mgmt

# Optional: override the postgres image (e.g. for China users who can't reach docker.io directly)
# POSTGRES_IMAGE=docker.m.daocloud.io/postgres:16-alpine

# ─── M4: AI 审核（OpenAI 兼容接口） ────────────────────────────────────────
# 后端代调，所有用户共用这一份 Key（计费由部署方承担）
OPENAI_API_KEY=<<请填写：OpenAI 或兼容服务的 API Key>>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# 上传文件大小上限（字节）。默认 20MB
UPLOAD_MAX_BYTES=20971520
