PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# First-run admin seed (only used if no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=系统管理员

# PostgreSQL — used by both docker-compose and the app
PG_DB=case_mgmt
PG_USER=case_mgmt
PG_PASSWORD=changeme
DATABASE_URL=postgres://case_mgmt:changeme@127.0.0.1:5432/case_mgmt

# Optional: override the postgres image (e.g. for China users who can't reach docker.io directly)
# POSTGRES_IMAGE=docker.m.daocloud.io/postgres:16-alpine

# ─── M4: AI 审核（OpenAI 兼容接口） ────────────────────────────────────────
# 后端代调，所有用户共用这一份 Key（计费由部署方承担）
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_DEFAULT=gpt-4o-mini

# 上传文件大小上限（字节）。默认 20MB
UPLOAD_MAX_BYTES=20971520
